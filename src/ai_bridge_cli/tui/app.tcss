Screen {
    layout: vertical;
}

#pane-nav {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#filters {
    height: auto;
    padding: 0 1;
    background: $boost;
}

#search {
    width: 1fr;
    min-width: 20;
    border: tall $primary 40%;
}

#filter-controls {
    width: auto;
    height: auto;
    border: round $primary 40%;
    margin-left: 1;
}

#search, #filter-controls, #table, #side {
    border-title-color: $text-muted;
    border-title-align: left;
}

#search:focus-within, #filter-controls:focus-within, #table:focus-within, #side:focus-within {
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

#filters Select {
    width: 18;
    margin-left: 1;
    margin-top: 0;
}

#filters #project {
    width: 28;
}

/* Below the wide tier, filters stay visible on their own row under search. */
.narrow #filters, .medium #filters {
    layout: vertical;
}

.narrow #filter-controls, .medium #filter-controls {
    layout: grid;
    grid-size: 4;
    grid-gutter: 0 1;
    grid-rows: 1;
    width: 1fr;
    height: auto;
    margin-left: 0;
}

.narrow #filter-controls {
    grid-size: 2;
}

.narrow #filters Select, .medium #filters Select,
.narrow #filters #project, .medium #filters #project {
    width: 1fr;
    margin-left: 0;
}

#body {
    height: 1fr;
}

#table {
    width: 1fr;
    height: 1fr;
    scrollbar-gutter: stable;
    border: round $primary 40%;
}

#side {
    width: 38%;
    min-width: 40;
    height: 1fr;
    border: round $primary 40%;
    padding: 0 1;
}

#side.full {
    width: 1fr;
}

#details {
    margin-bottom: 1;
    padding-bottom: 1;
    border-bottom: solid $primary 30%;
}

#empty {
    display: none;
    height: auto;
    padding: 1 2;
    color: $text-muted;
}

#statusbar {
    height: 1;
    padding: 0 1;
    background: $panel;
}

/* -- dialogs ---------------------------------------------------------- */

.dialog {
    align: center middle;
    background: $background 60%;
}

.box {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

.box.wide {
    width: 110;
}

.box.danger {
    border: thick $error;
}

.box-title {
    text-style: bold;
    margin-bottom: 1;
}

.box-body {
    height: auto;
    max-height: 30;
}

.box Input {
    margin: 1 0;
}

.box OptionList {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
}

.buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.buttons Button {
    margin-left: 2;
}

.removal .buttons Button, .native-delete .buttons Button {
    width: 1fr;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.removal .group-title {
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
}

.removal .removal-row {
    align-horizontal: left;
    margin-top: 0;
}

.removal .removal-row Button {
    text-wrap: nowrap;
    text-overflow: clip;
}

.removal.stacked .removal-row {
    layout: vertical;
}

.removal.stacked .removal-row Button {
    width: 100%;
    height: 1;
    border: none;
}

.process-stop #cancel {
    width: 12;
}

.codex-removal, .permanent-delete .box {
    max-width: 100%;
    padding: 1;
}

.codex-removal {
    width: 84;
}

.permanent-delete #cancel {
    width: 10;
}

.native-delete .box-body {
    height: 1fr;
}

#trash-table {
    height: auto;
    max-height: 24;
    margin-bottom: 1;
}
