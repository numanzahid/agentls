Screen {
    layout: vertical;
}

/* lazygit-style scrollbars: one column, a half-block thumb and no track (see scrollbar.py). */
* {
    scrollbar-size-vertical: 1;
    scrollbar-color: $foreground;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
}

/* Every pane: same round border, full terminal width; borders touch with no gap, as in lazygit. */
#filters, #body {
    height: auto;
}

#search {
    width: 1fr;
    min-width: 20;
    height: 3;
    padding: 0 1;
    border: round $foreground;
}

#filter-controls {
    width: auto;
    height: auto;
    border: round $foreground;
}

/* No fills on the main screen: panes, controls and bars sit on the terminal background. */
#search, #search:focus, #filter-controls, #table, #side, #keybar,
#filters Select > SelectCurrent, #table > .datatable--header {
    background: transparent;
}

#search, #filter-controls, #table, #side {
    border-title-color: $foreground;  /* same as the border: the list title fills it with lines */
    border-title-align: left;
    border-subtitle-color: $text-muted;
    border-subtitle-align: right;
}

#search:focus-within, #filter-controls:focus-within, #table:focus-within, #side:focus-within {
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $accent;
}

#filters Select {
    width: 18;
    margin-left: 1;
    margin-top: 0;
}

#filters #agent {
    margin-left: 0;
}

#filters #project {
    width: 24;
}

/* Below the wide tier, filters stay visible on their own rows under search. */
.narrow #filters, .medium #filters {
    layout: vertical;
}

.narrow #filter-controls, .medium #filter-controls {
    layout: grid;
    grid-size: 3;
    grid-gutter: 0 1;
    grid-rows: 1;
    width: 1fr;
    height: auto;
    margin-left: 0;
}

.narrow #filter-controls {
    grid-size: 2;
}

.narrow #filters Select, .medium #filters Select,
.narrow #filters #project, .medium #filters #project {
    width: 1fr;
    margin-left: 0;
}

#body {
    height: 1fr;
}

#table {
    width: 1fr;
    height: 1fr;
    scrollbar-gutter: stable;
    border: round $foreground;
}

#side {
    width: 38%;
    min-width: 40;
    height: 1fr;
    border: round $foreground;
    padding: 0 1;
}

#side.full {
    width: 1fr;
}

#details {
    margin-bottom: 1;
    padding-bottom: 1;
    border-bottom: solid $foreground;
}

#empty {
    display: none;
    height: auto;
    padding: 1 2;
    color: $text-muted;
}

/* lazygit's optionsTextColor: the whole key line in the theme's blue. */
#keybar {
    height: 1;
    padding: 0 1;
    color: $primary;
}

/* -- dialogs ---------------------------------------------------------- */

.dialog {
    align: center middle;
    background: $background 60%;
}

.box {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

.box.wide {
    width: 110;
}

.box.danger {
    border: thick $error;
}

.box-title {
    text-style: bold;
    margin-bottom: 1;
}

.box-body {
    height: auto;
    max-height: 30;
}

.box Input {
    margin: 1 0;
}

.box OptionList {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
}

.buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.buttons Button {
    margin-left: 2;
}

.removal .buttons Button, .native-delete .buttons Button {
    width: 1fr;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.removal .group-title {
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
}

.removal .removal-row {
    align-horizontal: left;
    margin-top: 0;
}

.removal .removal-row Button {
    text-wrap: nowrap;
    text-overflow: clip;
}

.removal.stacked .removal-row {
    layout: vertical;
}

.removal.stacked .removal-row Button {
    width: 100%;
    height: 1;
    border: none;
}

.process-stop #cancel {
    width: 12;
}

.codex-removal, .permanent-delete .box {
    max-width: 100%;
    padding: 1;
}

.codex-removal {
    width: 84;
}

.permanent-delete #cancel {
    width: 10;
}

.native-delete .box-body {
    height: 1fr;
}

#trash-table {
    height: auto;
    max-height: 24;
    margin-bottom: 1;
}
